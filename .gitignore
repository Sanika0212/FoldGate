mlartifacts/

# Evidently reports are regenerated by the shift run.
runs/**/*.html

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Lightning CSV logs from training runs.
runs/lightning/
